# Builder stage: install dependencies with uv
FROM harbor.cta-observatory.org/proxy_cache/python:3.12-slim AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=harbor.cta-observatory.org/proxy_cache/astral/uv:0.11.11 /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc && \
    rm -rf /var/lib/apt/lists/*

ARG SETUPTOOLS_SCM_PRETEND_VERSION=0.1.0
ENV UV_PYTHON_DOWNLOADS=0 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION=$SETUPTOOLS_SCM_PRETEND_VERSION

WORKDIR /app

# Install dependencies first
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-editable

# Copy project source
COPY auth_service /app/auth_service
COPY ctao_shared /app/ctao_shared

# Install the project
RUN uv sync --locked --no-dev --no-editable

# Runtime stage
FROM harbor.cta-observatory.org/proxy_cache/python:3.12-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --shell /bin/bash appuser

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

USER appuser

ENV PATH="/app/.venv/bin:$PATH"

WORKDIR /app

EXPOSE 8001

CMD ["uvicorn", "auth_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
