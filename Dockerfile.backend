# Backend (FastAPI)
# Builder stage: install dependencies with uv
FROM harbor.cta-observatory.org/proxy_cache/python:3.12-slim AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=harbor.cta-observatory.org/proxy_cache/astral/uv:0.11.11 /uv /uvx /bin/

# System build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc && \
    rm -rf /var/lib/apt/lists/*

ARG SETUPTOOLS_SCM_PRETEND_VERSION=0.1.0
ENV UV_PYTHON_DOWNLOADS=0 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION=$SETUPTOOLS_SCM_PRETEND_VERSION

WORKDIR /app

# Install dependencies
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-editable

# Copy the rest of the project
COPY api ./api
COPY auth_service ./auth_service
COPY ctao_shared ./ctao_shared
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Install the project
RUN uv sync --locked --no-dev --no-editable

# Runtime stage
FROM harbor.cta-observatory.org/proxy_cache/python:3.12-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Runtime system dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --uid 1000 --shell /bin/bash appuser

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --from=builder --chown=appuser:appuser /app/alembic /app/alembic
COPY --from=builder --chown=appuser:appuser /app/alembic.ini /app/alembic.ini

USER appuser

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
